{
  "name": "vite-react-template",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "prepare": "vp config",
    "clean": "rm -rf node_modules",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt . --check",
    "format:fix": "vp fmt . --write",
    "test": "vp test run",
    "check": "npm run lint && npm run format && npm run tsc && npm run test",
    "tsc": "tsc -p tsconfig.json",
    "dev": "vp dev --host",
    "build": "npm run build:sw:dev && vp build",
    "preview": "vp preview",
    "build:sw": "export NODE_ENV=production && node ./build.config.js",
    "build:sw:dev": "export NODE_ENV=development && node ./build.config.js"
  },
